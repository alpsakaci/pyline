{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Tests with HTML Coverage",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "--cov=pyline",
                "--cov-report=html"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
